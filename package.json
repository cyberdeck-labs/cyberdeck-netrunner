{
  "name": "cyberdeck-netrunner",
  "productName": "Cyberdeck Netrunner",
  "version": "0.3.4",
  "description": "Chromium-Browser im Cyberpunk-Stil (Electron)",
  "main": "src/main.js",
  "author": "Cyberdeck Labs",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.57.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "at.lea.cyberdeck.netrunner",
    "productName": "Cyberdeck Netrunner",
    "artifactName": "CyberdeckNetrunner-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "cyberdeck-netrunner",
      "desktop": {
        "entry": {
          "StartupWMClass": "cyberdeck-netrunner"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Cyberdeck Netrunner"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cyberdeck-labs",
        "repo": "cyberdeck-netrunner",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Cyberdeck Labs"
  },
  "desktopName": "cyberdeck-netrunner.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberdeck-labs/cyberdeck-netrunner.git"
  }
}
